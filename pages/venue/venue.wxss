.page-container {
  background-color: #f5f3f3;
  padding-bottom: 20rpx;
}

.venue-intro {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.venue-background {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  filter: blur(5rpx);
  white-space: nowrap;
  text-align: center;
}

.venue-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.venue-info {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.venue-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.venue-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #f0f0f0;
  margin-bottom: 10rpx;
}

.venue-description {
  font-size: 24rpx;
  text-align: center;
  width: 700rpx;
  color: #f0f0f0;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-line;
  margin: 2.5rpx 0.5rpx 2.5rpx 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
}

.address-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
}

.address-left {
  display: flex;
  align-items: center;
}

.location-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.address {
  font-size: 30rpx;
  color: #333;
}

.address-right {
  display: flex;
  align-items: center;
}

.phone-icon {
  width: 40rpx;
  height: 40rpx;
}

.booking-section {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
}

.booking-header {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.contact-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.option-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.option-name {
  font-size: 28rpx;
  color: #333;
}

/*  old */
.introduction {
  white-space: nowrap;
  display: flex;
}

.pic-item {
  margin: 10px;
  margin-right: 0px;
  display: inline-flex;
}

.pic-item-image {
  border-radius: 15rpx;
}

.team-section {
  background-color: #ffffff;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin: 20rpx;
}

.team-header {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.team-cards {
  display: flex;
  flex-direction: row;
  overflow-x: scroll;
  white-space: nowrap;
}

.team-cards .cards {
  display: inline-block;
}

.team-cards::-webkit-scrollbar {
  display: none;
}

.card {
  background-color: #ffffff;
  width: 200rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.3s ease;
}

.card:hover {
  transform: translateY(-5rpx);
}

.card .coach-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  object-fit: cover;
}

.card .coach-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.card .coach-title {
  font-size: 26rpx;
  color: #666;
}
