.index-container {
  position: relative;
  background: #f5f4f4;
  min-height: 100vh;
}

.slogan-wrapper {
  position: relative;
}

.slogan-wrapper swipper {
  width: 100%;
}

.slogan-wrapper swipper swipper-item image {
  width: 100%;
  border-radius: 20rpx;
}

.search-wrapper {
  position: absolute;
  width: 90%;
  top: 18%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: #fff;
  border-radius: 50rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 123, 255, 0.5);
  z-index: 10;
}

.search-input {
  width: 100%;
  border: none;
  background-color: transparent;
  outline: none;
  display: flex;
}

van-icon {
  size: 20;
  margin-right: 20rpx;
}

.search {
  padding: 3rpx;
  border: 1px solid;
  border-radius: 80rpx;
  margin: 10rpx;
  display: flex;
  background-color: #fff;
  box-shadow: 0 8rpx 12rpx rgba(0, 123, 255, 0.5);
}

.search .cityipt {
  padding: 20rpx;
}

.search .presearch {
  padding: 20rpx;
}

.search .icon {
  padding-top: 20rpx;
}

.introduction {
  width: 100%;
  height: 220rpx;
  background: #eee;
  white-space: nowrap;
}

.introduction .venuvPic {
  width: 220rpx;
  height: 220rpx;
  background: palegreen;
  margin-right: 10rpx;
  display: inline-block;
}

.introduction .venuvPic:last-child {
  margin-right: 0;
}

.recommend {
  display: inline;
  margin-top: 600rpx;
  padding: 20rpx;
}

.recommend .title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx;
}

.recommend .title .fujin {
  font-size: 40rpx;
}

.recommend .title .more {
  font-size: 25rpx;
}
