  <view class="loginCheck" wx:if="{{!isLoggedIn}}">
    <!-- <button class="login-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">手机号一键登录</button> -->
    <button class="login-button" bind:tap="onGetMockPhoneNumber">手机号一键登录</button>
  </view>
  <view class="logined" wx:else>
    <view class="info">
      <view class="avatar" bind:tap="onLoginClick">
        <image class="pic" src="{{userInfo.avatarUrl}}" mode="widthFix" wx:if="{{userInfo.avatarUrl}}"></image>
      </view>

      <view class="loginDesc" wx:if="{{!userInfo.nickName}}">
        <view>未设置昵称</view>
      </view>
      <view class="loginDesc" wx:else>
        <view>{{userInfo.nickName}}</view>
      </view>
    </view>

    <view class="feature-section">
      <view class="feature-header">常用功能</view>
      <view class="options">
        <!-- <view class="option">
