        <view class="option" bind:tap="onFeedbackClick">
          <van-icon class="option-icon" size="60rpx" name="question-o" />
          <text class="option-name">问题反馈</text>
        </view>
      </view>
    </view>

    <view class="footer">
      <text>©DropFit</text>
    </view>

    <view class="clientele">
      <button class="btn" open-type="contact"></button>
      <image class="pic" src="/static/images/clientele.png"></image>
