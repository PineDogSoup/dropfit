<view class="container">
  <view class="timer-name">AMRAP</view>

  <view class="time-selection">
    <view class="timer-desc">As many rounds ad possible in</view>
    <view class="time-box" bindtap="showTimePicker">
      <view class="time-count-box">
        {{ selectedTime }}
      </view>
      <view class="unit">
        minutes
      </view>
    </view>
  </view>

  <van-button class="start-button" round size="large" type="info" color="#ff9a00" bind:click="startTimer">
    <view class="title">START TIMER</view>
  </van-button>

  <!-- 时间选择器 -->
  <van-popup show="{{ showTimePickerPopup }}" position="bottom" custom-style="height: 50%;">
    <van-picker show-toolbar columns="{{ timeColumns }}" bind:confirm="onTimeConfirm" bind:cancel="onPickerCancel" default-index="{{ 32 }}" />
  </van-popup>
</view>