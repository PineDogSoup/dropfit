<van-notice-bar left-icon="volume-o" text="小吗喽正在加速审核和上传数据,请小伙伴们耐心等待~" />
<view class="container">
  <view class="venue-list" wx:if="{{venues}}">
    <view class="venue-item">
      <collect-record wx:for="{{venues}}" wx:key="_id" venue="{{item}}" bind:tap="review" />
    </view>
  </view>
  <van-empty class="custom-image" image="https://img.yzcdn.cn/vant/custom-empty-image.png" description="您未收录过场馆" wx:else />

  <view class="create-bottom">
    <van-button type="primary" size="large" form-type="submit" round bind:tap="onSubmit" color="#007aff">去收录</van-button>
  </view>

</view>

<!-- 广告 -->
<ad-custom class="ad" unit-id="adunit-2556dd6b58e98ae1" bindload="adLoad" binderror="adError" bindclose="adClose"></ad-custom>